# Copy to .env.docker. Never commit the real file.

# Compose-only settings
COMPOSE_PROJECT_NAME=pskit2
PSKIT_IMAGE=pskit2:0.3.0
PSKIT_SCIENCE_IMAGE=pskit2-science:0.3.0
PSKIT_LISTEN_ADDRESS=127.0.0.1
PSKIT_PORT=10716
# For AlphaFold3 nested containers on a server, set both values to the same
# absolute host path (for example /data1/pskit-production/data).
PSKIT_DATA_VOLUME=pskit_data
PSKIT_DATA_DIR=/app/backend/data
PSKIT_ARTIFACT_DIR=/app/backend/data/artifacts
PSKIT_DATABASE_URL=sqlite:////app/backend/data/pskit2.sqlite3

# Application
APP_ENV=production
# Public registration is enabled for this delivery. The Web middleware limits
# registration and login request bursts before password hashing is attempted.
REGISTRATION_MODE=open
INITIAL_ADMIN_BOOTSTRAP_TOKEN=
SESSION_COOKIE_NAME=pskit_session
SESSION_TTL_DAYS=3
COOKIE_SECURE=true
PSKIT_MAX_ACTIVE_SESSIONS_PER_USER=5
PSKIT_MAX_ACTIVE_TASKS_PER_USER=4
PSKIT_MAX_ACTIVE_AF3_PER_USER=10
PSKIT_MAX_GLOBAL_ACTIVE_TASKS=100
PSKIT_MAX_GLOBAL_ACTIVE_AF3=20
# Only these direct peers may supply X-Real-IP/X-Forwarded-For. On A6000 this
# is the Aliyun VPN address; never use 0.0.0.0/0.
TRUSTED_PROXY_IPS=10.9.8.1/32
AUTH_LOGIN_LIMIT=30
AUTH_REGISTER_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# OpenAI-compatible LLM. The UI and health endpoint work without a key,
# but Agent chat requires a configured provider.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=

# Embeddings/RAG. Leave the key empty to use keyword fallback.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
QDRANT_COLLECTION=pskit_knowledge
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine

# Optional providers
SERPAPI_API_KEY=
REMOTE_RNA_EXPERT_SSE_URL=
PEPCCD_MCP_URL=
PEPCCD_MCP_TOOL_NAME=pepccd_generate_peptides

# Optional outbound HTTP proxy used by the containers.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,web,worker,qdrant
http_proxy=
https_proxy=
no_proxy=127.0.0.1,localhost,web,worker,qdrant

# Heavy BioAI tools are intentionally not bundled in the core image.
# Add read-only mounts and set container paths only after installing the
# compatible legacy runtime and accepting each model/tool license.
# PSKIT_LEGACY_ROOT=/opt/pskit-legacy
# PSKIT_MODEL_PARAMETERS=/opt/pskit-models
# PSKIT_FOLDSEEK=/usr/local/bin/foldseek
# PSKIT_DSSP=/usr/local/bin/mkdssp
# PSKIT_AF3_DB_DIR=/opt/alphafold3/db
# PSKIT_AF3_MODEL_DIR=/opt/alphafold3/models
PSKIT_AF3_IMAGE=alphafold3:3.0.1
PSKIT_AF3_GPU_DEVICE=0
PSKIT_AF3_ALLOWED_GPU_DEVICES=0
TASK_SUBPROCESS_TIMEOUT_SECONDS=1800
TASK_MCP_TIMEOUT_SECONDS=900
TASK_STALE_AFTER_SECONDS=7200
TASK_HEARTBEAT_SECONDS=10
TASK_MAX_ATTEMPTS=2
PSKIT_AF3_TIMEOUT_SECONDS=3600
LLM_STREAM_READ_TIMEOUT_SECONDS=120
WORKER_READINESS_REQUIRED=true
# Enable these strict gates only after the science mounts/MCP endpoints and
# the vector collection have been provisioned.
SCIENCE_READINESS_REQUIRED=false
READINESS_REQUIRE_QDRANT=false
