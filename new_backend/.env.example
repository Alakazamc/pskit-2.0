RESEARCH_AGENT_MODE=mock
RESEARCH_AGENT_RUNTIME=mock
# auto uses mock MCP/AF3 in mock mode and disables them in live mode:
# RESEARCH_AGENT_MCP_EXECUTOR=auto
# RESEARCH_AGENT_AF3_EXECUTOR=auto
# To run contract substitutes with live identity, explicitly set both to mock.

# Optional Pi RPC mode (AF3 stays mock; first run: cd pi && npm ci --ignore-scripts):
# RESEARCH_AGENT_RUNTIME=pi
# RESEARCH_AGENT_DB_PATH=./data/agent.sqlite3
# RESEARCH_AGENT_PI_PROVIDER=deepseek
# RESEARCH_AGENT_PI_MODEL=deepseek-chat
# RESEARCH_AGENT_INTERNAL_API_URL=http://127.0.0.1:18080
# DEEPSEEK_API_KEY=server-side-key
# Optional compute callback contract for a future AF3 worker; mock timer is disabled:
# RESEARCH_AGENT_AF3_EXECUTOR=callback
# RESEARCH_AGENT_COMPUTE_CALLBACK_KEY=generate-a-long-random-secret
# AF3 jobs using at least this many estimated GPU minutes require a user decision:
# RESEARCH_AGENT_AF3_APPROVAL_THRESHOLD=30

# Live identity (independent of the model gateway):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional, server-only, used only by scripts/cleanup_guests.py --execute:
# SUPABASE_SECRET_KEY=your-supabase-secret-key
# Anonymous visitors are enabled by default only in mock mode. Live mode requires
# Supabase anonymous sign-ins and CAPTCHA/Turnstile enabled, plus a shared secret:
# RESEARCH_AGENT_ANONYMOUS_ENABLED=true
# RESEARCH_AGENT_ANONYMOUS_CAPTCHA_REQUIRED=true
# RESEARCH_AGENT_ANON_RATE_SECRET=generate-a-shared-random-secret-at-least-16-characters
# RESEARCH_AGENT_ANON_RATE_LIMIT_PER_HOUR=10
# Account defaults; operator per-user quota overrides take precedence:
# RESEARCH_AGENT_GUEST_MONTHLY_TOKEN_LIMIT=20000
# RESEARCH_AGENT_GUEST_DAILY_GPU_MINUTES=0
# RESEARCH_AGENT_GUEST_MAX_ACTIVE_RUNS=1
# Guests have no MCP tools by default. Operators may allow specific low-cost tools:
# RESEARCH_AGENT_GUEST_MCP_ALLOWED_TOOLS_JSON=["search_pdb"]
# RESEARCH_AGENT_GUEST_FILE_LIMIT_BYTES=2097152
# RESEARCH_AGENT_GUEST_STORAGE_LIMIT_BYTES=10485760
# RESEARCH_AGENT_MEMBER_MONTHLY_TOKEN_LIMIT=1000000
# RESEARCH_AGENT_MEMBER_DAILY_GPU_MINUTES=60
# Optional OpenAI-compatible model gateway for live Pi (LiteLLM, New API, or direct provider):
# MODEL_GATEWAY_BASE_URL=https://your-gateway.example/v1
# MODEL_GATEWAY_MODEL=your-model-id
# MODEL_GATEWAY_API_KEY=server-side-key
# Legacy New API address/model names remain available during migration:
# NEW_API_BASE_URL=https://your-new-api.example
# NEW_API_MODEL=your-model-id
# Use MODEL_GATEWAY_API_KEY for New API as well. Per-user key maps are rejected.
# RESEARCH_AGENT_USER_TOKEN_LIMITS_JSON={"supabase-user-id":1000000}
# Optional operator-only quota endpoint; send this key only from trusted server tooling:
# RESEARCH_AGENT_ADMIN_API_KEY=generate-a-long-random-secret
# RESEARCH_AGENT_FRONTEND_URL=http://localhost:5174
# RESEARCH_AGENT_PUBLIC_API_URL=http://localhost:18080
# RESEARCH_AGENT_AUTH_COOKIE_SECURE=false
