# PSKit 2.0 environment template
# Copy this file to .env, edit values, then run: chmod 600 .env
# Do not commit .env or real API keys.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Bind address for direct server access.
# Trusted-LAN example: PSKIT_BIND=0.0.0.0:10716
# Local-only example: PSKIT_BIND=127.0.0.1:10716
PSKIT_BIND=127.0.0.1:10716

APP_ENV=development
DATABASE_URL=sqlite:///./data/pskit2.sqlite3

# Runtime PID/log directory used by scripts/pskit2_ctl.sh.
PSKIT_RUN_DIR=/tmp/pskit2

# -----------------------------------------------------------------------------
# Authentication and cookies
# -----------------------------------------------------------------------------

SESSION_COOKIE_NAME=pskit_session
SESSION_TTL_DAYS=14
SESSION_TOUCH_INTERVAL_SECONDS=300
REGISTRATION_MODE=open
INITIAL_ADMIN_BOOTSTRAP_TOKEN=
TRUSTED_PROXY_IPS=
AUTH_LOGIN_LIMIT=30
AUTH_REGISTER_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Set COOKIE_SECURE=true only when serving over HTTPS.
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# LLM chat provider
# -----------------------------------------------------------------------------

# Any OpenAI-compatible /chat/completions endpoint can be used.
# DeepSeek example:
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-v4-flash
LLM_API_KEY=replace-me

# Other examples:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL_ID=deepseek/deepseek-chat-v3-0324:free

# -----------------------------------------------------------------------------
# Embedding and rerank
# -----------------------------------------------------------------------------

# BAAI/bge-m3 produces 1024-dimensional vectors.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=replace-me

# Compatibility aliases also supported by the backend:
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_MODEL_NAME=BAAI/bge-m3
# EMBED_API_KEY=replace-me

RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# -----------------------------------------------------------------------------
# Qdrant vector database
# -----------------------------------------------------------------------------

# Use either QDRANT_URL or QDRANT_PATH.
# If QDRANT_PATH is set, PSKit uses embedded local Qdrant storage.

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_PATH=
QDRANT_COLLECTION=pskit_knowledge
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine

# Single-server embedded example:
# QDRANT_PATH=./data/qdrant-local
# QDRANT_URL=

# -----------------------------------------------------------------------------
# Search and external APIs
# -----------------------------------------------------------------------------

SERPAPI_API_KEY=replace-me

# CORAL MCP uses SSE; PepCCD MCP uses Streamable HTTP.
REMOTE_RNA_EXPERT_SSE_URL=
PEPCCD_MCP_URL=
PEPCCD_MCP_TOOL_NAME=pepccd_generate_peptides

# Timeout for CORAL and PepCCD MCP tasks.
TASK_MCP_TIMEOUT_SECONDS=900

# Public biological database endpoints. Defaults usually work.
RCSB_SEARCH_URL=https://search.rcsb.org/rcsbsearch/v2/query
RCSB_DATA_BASE=https://data.rcsb.org/rest/v1/core/entry
RCSB_FILES_BASE=https://files.rcsb.org/download
UNIPROT_SEARCH_URL=https://rest.uniprot.org/uniprotkb/search
UNIPROT_ENTRY_BASE=https://rest.uniprot.org/uniprotkb
RNACENTRAL_SEARCH_URL=https://rnacentral.org/api/v1/rna
RNACENTRAL_ENTRY_BASE=https://rnacentral.org/api/v1/rna

# -----------------------------------------------------------------------------
# PSKit legacy BioAI runtime
# -----------------------------------------------------------------------------

# Original PSKit runtime root used by compatibility subprocess tasks.
PSKIT_LEGACY_ROOT=

# Model directory containing INABe/RNA-FM/ESM/SaProt-compatible weights.
PSKIT_MODEL_PARAMETERS=

# External binaries.
PSKIT_FOLDSEEK=/path/to/foldseek
PSKIT_DSSP=/path/to/mkdssp

# Task subprocess timeout in seconds.
TASK_SUBPROCESS_TIMEOUT_SECONDS=1800

# -----------------------------------------------------------------------------
# AlphaFold3
# -----------------------------------------------------------------------------

PSKIT_AF3_DB_DIR=
PSKIT_AF3_MODEL_DIR=
PSKIT_AF3_IMAGE=alphafold3:3.0.1
PSKIT_AF3_GPU_DEVICE=0

# -----------------------------------------------------------------------------
# Artifact storage
# -----------------------------------------------------------------------------

# Current implementation uses local filesystem artifacts.
ARTIFACT_DIR=./data/artifacts
