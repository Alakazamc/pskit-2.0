# LLM
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-v4-flash
LLM_API_KEY=replace-me

# Embedding / rerank
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=replace-me
# Compatible aliases are also accepted: EMBED_BASE_URL, EMBED_MODEL_NAME, EMBED_API_KEY.
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=replace-me

# Databases
DATABASE_URL=postgresql+psycopg://pskit:pskit@127.0.0.1:5432/pskit
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_PATH=
QDRANT_COLLECTION=pskit_knowledge
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine

# Object storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=pskit-artifacts
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# BioAI runtime
PSKIT_MODEL_PARAMETERS=/data1/kxchen/pskit-data/model_parameters
PSKIT_FOLDSEEK=/data1/kxchen/opt/foldseek/bin/foldseek
PSKIT_DSSP=/data1/kxchen/opt/root/usr/bin/mkdssp
PSKIT_AF3_DB_DIR=/home/public/database/alphafold3
PSKIT_AF3_MODEL_DIR=/data/hzeng/af3/model-parameters
PSKIT_AF3_IMAGE=alphafold3:3.0.1
PSKIT_AF3_GPU_DEVICE=0
PSKIT_LEGACY_ROOT=/data1/kxchen/pskit

# External APIs
SERPAPI_API_KEY=replace-me
REMOTE_RNA_EXPERT_SSE_URL=http://172.31.226.126:8099/sse
