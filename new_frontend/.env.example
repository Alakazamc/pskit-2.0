# Frontend always calls the HTTP API. Use demo only with the Python mock backend.
# Production builds default to Supabase authentication when this variable is absent.
VITE_AUTH_MODE=demo
VITE_API_BASE_URL=/api/v1

# To use Python-backed Supabase login:
# VITE_AUTH_MODE=supabase
# Live anonymous signup with Supabase CAPTCHA also needs the public Turnstile site key:
# VITE_TURNSTILE_SITE_KEY=your-public-site-key
# For localhost UI testing, Cloudflare's visible always-pass test site key is:
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
