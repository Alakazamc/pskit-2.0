# Copy to .env and replace every placeholder. Keep .env out of Git.
# Use alphanumeric characters for the DB password because it is embedded in a URL.
LITELLM_DB_PASSWORD=replace-with-long-alphanumeric-password
LITELLM_MASTER_KEY=sk-replace-with-long-random-admin-key
LITELLM_SALT_KEY=sk-replace-with-long-random-salt
# Keep 127.0.0.1 locally. On the Aliyun WireGuard host, set 10.9.8.1.
LITELLM_BIND_IP=127.0.0.1
# Candidate gateway uses 4001; final gateway returns to 4000.
LITELLM_PUBLIC_PORT=4001
SUPABASE_DOCKER_NETWORK=pskit-agent-supabase_default
