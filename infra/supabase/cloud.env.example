# Apply these values to a fresh copy of .env.example, then generate new keys.
# This is a private stage: signup stays closed until SMTP and TLS work.
COMPOSE_FILE=docker-compose.yml:compose.cloud.yaml
CLOUD_SUPABASE_HTTP_PORT=18130
CLOUD_DISABLE_SIGNUP=true
SUPABASE_PUBLIC_URL=https://agent.bioailab.net
API_EXTERNAL_URL=https://agent.bioailab.net/auth/v1
SITE_URL=https://agent.bioailab.net
ADDITIONAL_REDIRECT_URLS=https://agent.bioailab.net/**
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
# Replace with real SMTP values before opening signup.
SMTP_HOST=unconfigured.invalid
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_ADMIN_EMAIL=replace-with-sender@example.invalid
SMTP_SENDER_NAME=Research Agent
