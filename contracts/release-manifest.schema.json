{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pskit.bioailab.net/contracts/release-manifest.schema.json",
  "title": "PSKit application release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha",
    "backend",
    "frontend",
    "database_schema_version",
    "pi_version",
    "litellm_version",
    "compatibility_sha256",
    "compose",
    "checks",
    "release_id",
    "opensandbox"
  ],
  "properties": {
    "schema_version": {
      "const": "pskit.release.v1"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64}|[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[0-9a-f]{64})$"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "database_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "pi_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "litellm_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "compatibility_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "files",
        "resolved_sha256",
        "workspace_provider"
      ],
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^pskit-agent-(local|staging|cloud)$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^deploy/agent/compose([.a-z-]+)?\\.ya?ml$"
          }
        },
        "resolved_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "workspace_provider": {
          "enum": [
            "disabled",
            "opensandbox"
          ]
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ci",
        "preflight",
        "smoke"
      ],
      "properties": {
        "ci": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence_sha256"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_tested"
              ]
            },
            "evidence_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence_sha256": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence_sha256"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_tested"
              ]
            },
            "evidence_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence_sha256": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "smoke": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence_sha256"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_tested"
              ]
            },
            "evidence_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence_sha256": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_version",
        "enforcement_version",
        "qualification_sha256"
      ],
      "properties": {
        "component_version": {
          "const": 1
        },
        "enforcement_version": {
          "const": "pskit.db-admission.v1"
        },
        "qualification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "opensandbox": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "image_reference",
        "capability_sha256"
      ],
      "properties": {
        "image_reference": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64}|[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[0-9a-f]{64})$"
        },
        "capability_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "compose": {
            "properties": {
              "workspace_provider": {
                "const": "opensandbox"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "opensandbox": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "opensandbox": {
            "type": "null"
          }
        }
      }
    }
  ]
}
