#!/usr/bin/env bash
# Use a pinned interpreter supplied by the separately approved host procedure.
set -Eeuo pipefail
agent_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_dir=$(cd -- "$agent_dir/../.." && pwd)
adapter_python=${PSKIT_ADMISSION_PYTHON:-"$repo_dir/new_backend/.venv/bin/python"}
if [[ "$adapter_python" != /* || ! -x "$adapter_python" ]]; then
  echo 'An absolute approved Python interpreter is required' >&2
  exit 1
fi
exec "$adapter_python" "$agent_dir/scripts/admission_adapter.py" "$@"
