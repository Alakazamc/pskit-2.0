# Copy to cloud.backend.env (0600). All values here are server-side.
RESEARCH_AGENT_MODE=live
RESEARCH_AGENT_RUNTIME=pi
RESEARCH_AGENT_AF3_EXECUTOR=callback
RESEARCH_AGENT_MCP_EXECUTOR=disabled
RESEARCH_AGENT_ANONYMOUS_ENABLED=false
RESEARCH_AGENT_AUTH_COOKIE_SECURE=true
# Start with observe, review 24–48 hours, then switch to enforce.
RESEARCH_AGENT_AUTH_ABUSE_MODE=observe
RESEARCH_AGENT_AUTH_RATE_LIMIT_SECRET=replace-with-random-hmac-secret-at-least-32-characters
RESEARCH_AGENT_AUTH_TRUSTED_PROXY_CIDRS_JSON=["127.0.0.1/32"]
RESEARCH_AGENT_AUTH_CAPTCHA_REQUIRED=true
TURNSTILE_SECRET_KEY=replace-with-turnstile-server-secret
TURNSTILE_HOSTNAMES_JSON=["agent.bioailab.net"]
RESEARCH_AGENT_DATABASE_URL=postgresql://pskit_app:replace-with-strong-pskit-password@db:5432/postgres
RESEARCH_AGENT_COMPUTE_CALLBACK_KEY=replace-with-fresh-random-secret-at-least-32-characters
RESEARCH_AGENT_AF3_MIN_GPU_MEMORY_MB=40000
SUPABASE_PUBLISHABLE_KEY=replace-with-cloud-publishable-key
# Same environment's Supabase secret key, for private avatar Storage. Never expose to React.
SUPABASE_SECRET_KEY=replace-with-cloud-secret-key
# The final gateway runs on the shared Supabase Docker network.
MODEL_GATEWAY_BASE_URL=http://gateway:4000/v1
MODEL_GATEWAY_MODEL=claude-opus-4-8
MODEL_GATEWAY_KIND=litellm
MODEL_GATEWAY_API_KEY=replace-with-new-shared-db-virtual-key
# Optional: aliases confirmed to accept images when LiteLLM omits supports_vision metadata.
MODEL_GATEWAY_IMAGE_MODELS_JSON=[]
# Optional small-model alias for first-reply naming; empty reuses that reply's model.
# The alias must remain visible to that user under the model publication policy.
RESEARCH_AGENT_TITLE_MODEL=
RESEARCH_AGENT_TITLE_TIMEOUT_SECONDS=15
# Management roles use ordinary verified user JWTs; bootstrap from the server CLI.
# Keep legacy model visibility until managed publication is tested in isolation.
RESEARCH_AGENT_MODEL_POLICY_MODE=legacy
# Scientific service drafts reference approved server endpoints/credential env names.
RESEARCH_AGENT_ADMIN_SERVICE_ENDPOINTS_JSON={}
RESEARCH_AGENT_ADMIN_SERVICE_CREDENTIALS_JSON={}
