# Copy to local.backend.env (0600). Never commit local.backend.env.
# Copy only the Supabase publishable key from your existing local setup.
RESEARCH_AGENT_MODE=live
RESEARCH_AGENT_RUNTIME=pi
RESEARCH_AGENT_AF3_EXECUTOR=callback
RESEARCH_AGENT_MCP_EXECUTOR=disabled
RESEARCH_AGENT_ANONYMOUS_ENABLED=false
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
RESEARCH_AGENT_COMPUTE_CALLBACK_KEY=replace-with-a-new-random-32-character-key
RESEARCH_AGENT_COMPUTE_SERVICE_KEYS_JSON={"coral-mcp":"replace-with-local-mcp-worker-key-at-least-32-characters"}
RESEARCH_AGENT_AF3_MIN_GPU_MEMORY_MB=40000
