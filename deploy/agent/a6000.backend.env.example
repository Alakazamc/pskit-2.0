# Copy to a6000.backend.env with permissions 0600. Use the existing cloud
# compute callback key and Supabase publishable key at cutover.
RESEARCH_AGENT_COMPUTE_CALLBACK_KEY=replace-with-existing-cloud-key-at-least-32-characters
RESEARCH_AGENT_AF3_MIN_GPU_MEMORY_MB=40000
SUPABASE_PUBLISHABLE_KEY=replace-with-cloud-publishable-key
SUPABASE_SECRET_KEY=replace-with-cloud-secret-key
# A private-stage model stub may be started with --profile private-test.
# Replace all three values with a real model gateway for production.
MODEL_GATEWAY_BASE_URL=http://model-gateway-mock:8000/v1
MODEL_GATEWAY_MODEL=local-stub
MODEL_GATEWAY_API_KEY=local-test-only
