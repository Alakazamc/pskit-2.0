# Copy to .env (0600) in the isolated cloud deployment directory.
AGENT_BACKEND_IMAGE=pskit-agent-backend:replace-with-release-id
AGENT_WEB_IMAGE=pskit-agent-web:replace-with-release-id
AGENT_BACKEND_ENV_FILE=./cloud.backend.env.example
AGENT_AF3_PROXY_KEY_FILE=./cloud.backend.env.example
AGENT_PUBLIC_URL=https://agent.bioailab.net
# Public key compiled into the matching React dist. This server-side marker lets preflight
# reject a release whose Turnstile setup was never completed.
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
AGENT_AF3_WORKER_ID=a6000-af3-cloud-1
AGENT_PROXY_UID=1000
AGENT_PROXY_GID=1000
AGENT_PG_DATA_VOLUME=pskit-agent-cloud-pg17-20261003_agent_data

# OpenSandbox overlay. Every image value is resolved and recorded by digest.
OPENSANDBOX_SERVER_IMAGE=pskit-opensandbox-server@sha256:replace-with-64-lowercase-hex
OPENSANDBOX_SANDBOX_IMAGE=pskit-workspace@sha256:replace-with-64-lowercase-hex
OPENSANDBOX_CONFIG_FILE=./opensandbox.private.toml
OPENSANDBOX_RUNTIME_NETWORK=pskit-agent-cloud-opensandbox-runtime
OPENSANDBOX_STATE_VOLUME=pskit-agent-cloud-opensandbox-state
OPENSANDBOX_VOLUME_DRIVER=replace-with-quota-capable-driver
OPENSANDBOX_VOLUME_SIZE=10Gi
OPENSANDBOX_CPU_MILLICORES=1000
OPENSANDBOX_MEMORY_BYTES=1073741824
OPENSANDBOX_PID_LIMIT=256
OPENSANDBOX_DISK_BYTES=10737418240
OPENSANDBOX_INODE_LIMIT=100000
# Store a distinct random value of at least 32 characters in the private file.
OPENSANDBOX_API_KEY=replace-with-private-random-secret

# Production rollout policy. Bind the directory instead of an individual file
# so an atomic policy.json replacement becomes visible inside the container.
OPENSANDBOX_ROLLOUT_DIR=./opensandbox-rollout
RESEARCH_AGENT_WORKSPACE_ENABLED=false
RESEARCH_AGENT_WORKSPACE_USER_ALLOWLIST_JSON=[]
RESEARCH_AGENT_WORKSPACE_COMMANDS_ENABLED=false
RESEARCH_AGENT_WORKSPACE_CAPABILITY_HASH=
