# Copy to mcp.receiver.env with mode 0600. This file is mounted only into the
# generic receiver; do not reuse the backend or frontend environment file.
PSKIT_COMPUTE_SERVICE_KEY=replace-with-distinct-mcp-worker-key-at-least-32-characters
# Map the immutable endpoint URI stored in a release to a receiver-local route.
PSKIT_MCP_ENDPOINT_OVERRIDES_JSON={}
# Map credential_ref values to environment variable names, never raw secrets.
PSKIT_MCP_CREDENTIAL_REFS_JSON={"coral-mcp-token":"CORAL_MCP_BEARER_TOKEN"}
CORAL_MCP_BEARER_TOKEN=replace-with-coral-bearer-token
